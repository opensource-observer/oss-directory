{
  "name": "oss-directory",
  "version": "0.1.0",
  "description": "Open source software directory",
  "repository": {
    "type": "git",
    "url": "https://github.com/opensource-observer/oss-directory.git"
  },
  "author": "Kariba Labs",
  "license": "Apache-2.0",
  "bin": "./dist/cli.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "pnpm types && tsc",
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "format:staged": "lint-staged",
    "lint": "tsc --noEmit && pnpm lint:eslint && pnpm lint:prettier",
    "lint:eslint": "eslint --ignore-path ./.gitignore --max-warnings 0 --cache .",
    "lint:prettier": "prettier --ignore-path ./.prettierignore --check **/*.{ts,yaml}",
    "prettier:write": "prettier --ignore-path ./.prettierignore --write **/*.{ts,yaml}",
    "migrate": "pnpm start run-migrations",
    "prepack": "pnpm build",
    "prepare": "husky install",
    "start": "node --loader ts-node/esm src/cli.ts",
    "test": "NODE_OPTIONS=\"--no-warnings --experimental-vm-modules\" jest --passWithNoTests",
    "transform": "pnpm start run-transformation",
    "types": "pnpm types:json && pnpm types:mv",
    "types:json": "pnpm json2ts -i './src/resources/schema/' -o 'src/types' --cwd './src/resources/schema'",
    "types:mv": "find src/types/ -name '*.d.ts' -type f | sed s/\\.d.ts$// | xargs -I _ bash -c 'mv _.d.ts _.ts'",
    "validate": "pnpm validate:collections && pnpm validate:projects && pnpm validate:logos",
    "validate:collections": "pnpm start validate-collections",
    "validate:projects": "pnpm start validate-projects",
    "validate:logos": "pnpm start validate-logos",
    "pyright": "pyright --pythonpath $(poetry env info --path)/bin/python"
  },
  "keywords": [],
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "minimatch@3": "^3.1.5",
      "minimatch@9": "^9.0.9",
      "js-yaml@3": "^3.15.1",
      "undici@5": "^6.28.0"
    }
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "json-schema-to-typescript": "^13.1.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^1.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "chalk": "^5.6.2",
    "csv": "^6.6.3",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "glob": "^10.5.0",
    "lodash": "^4.18.1",
    "mkdirp": "^3.0.1",
    "pyright": "^1.1.411",
    "simple-git": "^3.36.0",
    "tmp-promise": "^3.0.3",
    "ts-adt": "^2.1.2",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "yargs": "^17.7.3"
  }
}
